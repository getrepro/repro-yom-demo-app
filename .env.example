# Copy to .env.local. The application works with capture disabled.
REPRO_ENABLED=false
YOM_APP_PORT=5385
YOM_PLAYER_PORT=5386

# Set these only after installing the YOM feature SDK builds supplied by Repro.
# Use your own Repro application; no account credentials are distributed here.
REPRO_TENANT_ID=
REPRO_APP_ID=
REPRO_APP_SECRET=
REPRO_API_BASE_URL=
REPRO_LOG_COLLECTOR_URL=
REPRO_VIEWER_BASE_URL=
REPRO_CAPTURE_MODE=staging
REPRO_SAMPLE_RATE=1

# Optional gameplay video; requires a media-enabled Repro API.
REPRO_MEDIA_ENABLED=false
# Leave empty to use REPRO_API_BASE_URL when media is enabled.
REPRO_MEDIA_API_BASE_URL=

# Synthetic demo data only. For real customer data use an approved capture policy.
REPRO_CAPTURE_RAW=true
REPRO_PRIVACY_ENVIRONMENT=yom-poc

# Optional: npm start uses an existing dedicated LOCAL PostgreSQL database.
# npm run dev creates and removes its own disposable database instead.
YOM_DEMO_DATABASE_URL=
